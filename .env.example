# Copy this file to ".env" and fill in real values. Never commit ".env".

# Port the Express server runs on
PORT=3000

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# "anon" / "publishable" key. This is safe to send to the browser
# (Row Level Security is what actually protects your data, not this key being secret).
SUPABASE_ANON_KEY=your-anon-public-key

# "service_role" / "secret" key. This BYPASSES Row Level Security.
# Used only inside server.js to create/deactivate staff and to save admin settings.
# NEVER send this to the browser, never prefix it with a client-exposed var name.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Supabase Auth needs an email address to log in with. Staff only type a
# username + PIN, so the server turns "rahul" into "rahul@station.local"
# behind the scenes. Change this to something unique to you.
AUTH_EMAIL_DOMAIN=station.local
